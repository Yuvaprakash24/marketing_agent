# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true

# Database: keep USE_SQLITE=true for local development
USE_SQLITE=true
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Supabase (auth + storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
AWS_S3_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3

# LLM (OpenRouter) used for post ideas + copywriting
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-r1-0528:free

# Gemini, used for AI post images
GOOGLE_API_KEY=

# Research for post topics (optional, posts still generate without it)
SERPAPI_API_KEY=
SERPER_API_KEY=

# Facebook / Instagram publishing
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback/

# Twitter publishing
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CALLBACK_URI=http://localhost:8000/api/auth/twitter/callback/

# LinkedIn publishing
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback/
